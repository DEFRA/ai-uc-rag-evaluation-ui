{% extends "common/layout.njk" %}

{% block title %}
  <title>Truth Data Source | {{ serviceName }}</title>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Truth Data Source</h1>
    </div>
    <div class="govuk-grid-column-one-third govuk-!-text-align-right">
      <a href="/truth" class="govuk-link">Back to list</a>
    </div>
  </div>

  <dl class="govuk-summary-list govuk-!-margin-bottom-8">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">ID</dt>
      <dd class="govuk-summary-list__value govuk-!-font-family-monospace">{{ source.id }}</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Dataset ID</dt>
      <dd class="govuk-summary-list__value">{{ source.dataset_id }}</dd>
    </div>
  </dl>

  <h2 class="govuk-heading-l">Question and answer pairs</h2>

  <form method="post" action="/truth/{{ source.id }}">
    <input type="hidden" name="dataset_id" value="{{ source.dataset_id }}">
    <input type="hidden" name="count" value="{{ source.question_answers.length }}">

    {% if source.question_answers and source.question_answers.length %}
      {% for qa in source.question_answers %}
        <div class="govuk-summary-card govuk-!-margin-bottom-4">
          <div class="govuk-summary-card__title-wrapper">
            <h3 class="govuk-summary-card__title">Pair {{ loop.index }}</h3>
            <div class="govuk-summary-card__actions">
              <button
                class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                name="action"
                value="delete-{{ loop.index0 }}"
              >
                Delete
              </button>
            </div>
          </div>
          <div class="govuk-summary-card__content">
            <div class="govuk-form-group">
              <label class="govuk-label" for="question_{{ loop.index0 }}">
                Question
              </label>
              <input
                class="govuk-input"
                id="question_{{ loop.index0 }}"
                name="question_{{ loop.index0 }}"
                type="text"
                value="{{ qa.question }}"
              >
            </div>
            <div class="govuk-form-group">
              <label class="govuk-label" for="answer_{{ loop.index0 }}">
                Answer
              </label>
              <textarea
                class="govuk-textarea"
                id="answer_{{ loop.index0 }}"
                name="answer_{{ loop.index0 }}"
                rows="4"
              >{{ qa.answer }}</textarea>
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <p class="govuk-body">No question and answer pairs yet.</p>
    {% endif %}

    <div class="govuk-button-group govuk-!-margin-bottom-6">
      <button class="govuk-button govuk-button--secondary" name="action" value="add">
        Add question and answer
      </button>
    </div>

    <button class="govuk-button" name="action" value="save">
      Save changes
    </button>
  </form>
{% endblock %}